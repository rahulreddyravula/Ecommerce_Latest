PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_123456789_ecommerce_api_prod_key
JWT_EXPIRE=1d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_987654321_ecommerce_api_prod_key
JWT_REFRESH_EXPIRE=7d

# Uploader config
UPLOAD_LIMIT_SIZE=5242880 # 5MB

# SMS Gateway Provider Configuration
# Supported values: twilio, msg91, aws_sns, simulated
SMS_PROVIDER=simulated

# Twilio SMS Gateway Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# MSG91 SMS Gateway Configuration
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# AWS SNS SMS Gateway Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SNS_SENDER_ID=

